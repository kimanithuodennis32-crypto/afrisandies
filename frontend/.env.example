# Leave empty in production: the site and API are served from the same domain.
# For local dev, the app defaults to http://localhost:4000.
VITE_API_URL=

# Optional: image uploads in the Admin product form.
# cloudinary.com -> dashboard shows your cloud name; create an UNSIGNED upload
# preset under Settings > Upload > Upload presets.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
