generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  // Postgres (e.g. a free Neon database) — same engine in dev and
  // production, pointed to by DATABASE_URL. All JSON-shaped fields below
  // are stored as text columns, so this works identically to the SQLite
  // version this project started on.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id
  title       String
  priceKes    Int
  rating      Float    @default(4.5)
  category    String // "sandals" | "bags" | "hoodies"
  subcategory String?
  stock       Int      @default(50)
  active      Boolean  @default(true)

  // JSON-encoded (SQLite has no native array/JSON column type):
  images      String // { src: string; alt: string }[]
  colors      String // string[]
  sizes       String // (number | string)[]
  sizePricing String? // Record<string, number> | null
  patterns    String? // ProductPattern[] | null

  description String
  materials   String
  shipping    String

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderLines OrderLine[]

  @@index([category])
}

model Order {
  id       String @id @default(cuid())
  orderCode String @unique // e.g. "AF12345" — shown to the customer & used in WhatsApp msg

  customerName  String
  customerPhone String
  county        String?
  town          String?
  address       String?
  deliveryMethod String // "home" | "pickup"

  subtotalKes Int
  shippingKes Int
  totalKes    Int

  // pending -> awaiting M-Pesa confirmation; confirmed -> payment verified;
  // processing -> in production/fulfilment; shipped; completed; cancelled
  status String @default("pending")
  mpesaCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines OrderLine[]

  @@index([status])
  @@index([createdAt])
}

model OrderLine {
  id            String  @id @default(cuid())
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId     String?
  productTitle  String // snapshot at time of order, survives product edits/deletes
  unitPriceKes  Int
  qty           Int
  size          String?
  color         String?
  pattern       String?

  @@index([orderId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}
