# Postgres connection string (e.g. a free Neon project; ends with ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used to sign admin login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=4000

# Only needed in local dev (frontend on :5173). In production the site and API
# share one domain, so CORS isn't used.
CORS_ORIGIN=http://localhost:5173

# The seed script creates/updates this admin login on every deploy.
ADMIN_EMAIL=
ADMIN_PASSWORD=
