{
  "name": "afri-sandies",
  "private": true,
  "version": "1.0.0",
  "description": "AFRI SANDIES storefront (React) + API (Express/Prisma)",
  "engines": { "node": ">=18" },
  "scripts": {
    "postinstall": "prisma generate --schema backend/prisma/schema.prisma",
    "frontend:install": "npx --yes pnpm@9 --dir frontend install --frozen-lockfile",
    "frontend:build": "npx --yes pnpm@9 --dir frontend build",
    "db:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma && tsx backend/prisma/seed.ts",

    "build:netlify": "npm run frontend:install && npm run frontend:build && npm run db:deploy",

    "build:server": "tsc -p backend/tsconfig.json",
    "build": "npm run frontend:install && npm run frontend:build && npm run build:server && npm run db:deploy",
    "start": "node backend/dist/src/index.js",

    "dev:api": "tsx watch backend/src/index.ts",
    "dev:web": "npx --yes pnpm@9 --dir frontend dev",
    "seed": "tsx backend/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "serverless-http": "^3.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
